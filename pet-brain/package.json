{
  "name": "pet-brain",
  "version": "0.2.0",
  "description": "Cérebro do pet: MCP server que controla o Maestri e escreve no cofre Obsidian",
  "type": "module",
  "private": true,
  "bin": {
    "pet-brain": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
